{
  "name": "bookworm-light-nextjs",
  "author": "Themefisher",
  "version": "2.0.0",
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "node lib/jsonGenerator.js && node scripts/generateContentIndex.js && node scripts/generateViews.js && next dev",
    "build": "npm run clean && node lib/jsonGenerator.js && node scripts/generateContentIndex.js && node scripts/generateViews.js && next build && next-sitemap",
    "sync-content": "node scripts/syncContent.js",
    "export": "next build && next export && next-sitemap",
    "lint": "next lint",
    "start": "next start",
    "clean": "rimraf .next"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "axios": "1.19.0",
    "chart.js": "4.4.4",
    "firebase": "^11.4.0",
    "firebase-admin": "^13.1.0",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "marked": "4.2.4",
    "next": "15.5.23",
    "next-mdx-remote": "^6.0.0",
    "next-sitemap": "4.2.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-gtm-module": "^2.0.11",
    "react-icons": "4.7.1",
    "react-spinners": "0.14.1",
    "recharts": "2.12.7",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.3",
    "@tailwindcss/typography": "0.5.8",
    "autoprefixer": "^10.4.20",
    "date-fns": "2.29.3",
    "date-fns-tz": "1.3.7",
    "eslint": "8.48.0",
    "eslint-config-next": "15.5.23",
    "postcss": "^8.5.26",
    "prettier": "2.8.1",
    "prettier-plugin-tailwindcss": "0.2.1",
    "rimraf": "^5.0.0",
    "sass": "1.57.0",
    "sharp": "0.35.3",
    "tailwind-bootstrap-grid": "5.0.1",
    "tailwindcss": "^3.4.11"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp",
    "lodash": "^4.18.1"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "not IE 11",
    "not dead"
  ]
}
